NODE_ENV=development
DETECTION_INTERVAL_MS=2000
LOG_LEVEL=info
LOG_FILE=./logs/detection.log
LOG_MAX_SIZE_BYTES=1048576
LOG_MAX_FILES=5
EVENT_STORAGE_FILE=./data/detections.json
CONFIG_JSON_PATH=

WEBHOOK_ENABLED=false
WEBHOOK_URL=
WEBHOOK_RETRY_COUNT=3
WEBHOOK_RETRY_DELAY_MS=1000
WEBHOOK_TIMEOUT_MS=5000

EMAIL_ENABLED=false
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=screen-detector@example.com
EMAIL_TO=security@example.com

ACTION_BLUR=false
ACTION_LOCK=false
ACTION_TERMINATE=false
TERMINATE_TARGETS=obs64.exe,obs,sharex,snagit32,snagit64,camtasia,screenflow
